font-family = JetBrainsMono Nerd Font Mono
font-family-bold = JetBrainsMono NFM Bold
font-family-italic = JetBrainsMono NFM Italic
font-family-bold-italic = JetBrainsMono NFM Bold Italic

# Panele/splity obsługuje herdr (multiplekser). Ghostty trzymamy jako pojedyncze
# okno — nie używamy jego splitów, więc nie definiujemy goto_split/resize_split,
# a ctrl+hjkl przechodzi wprost do herdr (nawigacja panelami).
window-show-tab-bar = never

macos-option-as-alt = left
theme = TokyoNight
